{
    "name": "hub-vir",
    "version": "0.2.0",
    "description": "CLI that builds a static, deployable link hub website from a config file.",
    "keywords": [
        "hub",
        "portal",
        "link"
    ],
    "homepage": "https://github.com/electrovir/hub-vir",
    "bugs": {
        "url": "https://github.com/electrovir/hub-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/hub-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "hub-vir": "src/hub-vir.script.ts"
    },
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "tsx src/hub-vir.script.ts --dev",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.5.0",
        "@augment-vir/common": "^32.5.0",
        "@augment-vir/web": "^32.5.0",
        "@electrovir/color": "^2.0.0",
        "@virmator/frontend": "^14.37.2",
        "cli-vir": "^1.1.1",
        "config-vir": "^1.0.6",
        "element-vir": "^27.0.2",
        "object-shape-tester": "^6.15.1",
        "theme-vir": "^29.0.1",
        "tsx": "^4.23.15",
        "vira": "^33.3.0",
        "vite": "^8.3.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.5.0",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.6.4",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "c8": "^12.0.0",
        "cspell": "^10.3.6",
        "dependency-cruiser": "^18.5.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.0.1",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^76.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.1.0",
        "prettier": "3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "~4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^3.0.2",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "virmator": "^14.37.2"
    },
    "engines": {
        "node": ">=22"
    }
}
